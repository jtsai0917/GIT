			$objPHPExcel->getActiveSheet()->setCellValue($SIGNENG.'4', iconv("big5","utf-8","主任簽核"));
			$objPHPExcel->getActiveSheet()->getStyle($SIGNENG.'4')->applyFromArray($styleThinBlackBorderOutline); 
			$objPHPExcel->getActiveSheet()->setCellValue($SIGNENG.$SIGNNUM, iconv("big5","utf-8",getusername($SIGN1)));
			$objPHPExcel->getActiveSheet()->getStyle($SIGNENG.$SIGNNUM)->applyFromArray($styleThinBlackBorderOutline); 
			$SIGNENG++;
			$objPHPExcel->getActiveSheet()->setCellValue($SIGNENG.'4', iconv("big5","utf-8","主任備註"));
			$objPHPExcel->getActiveSheet()->getStyle($SIGNENG.'4')->applyFromArray($styleThinBlackBorderOutline); 
			$objPHPExcel->getActiveSheet()->setCellValue($SIGNENG.$SIGNNUM, iconv("big5","utf-8",$Remark1));
			$objPHPExcel->getActiveSheet()->getStyle($SIGNENG.$SIGNNUM)->applyFromArray($styleThinBlackBorderOutline); 
			$SIGNENG++;
			$objPHPExcel->getActiveSheet()->setCellValue($SIGNENG.'4', iconv("big5","utf-8","主管簽核"));
			$objPHPExcel->getActiveSheet()->getStyle($SIGNENG.'4')->applyFromArray($styleThinBlackBorderOutline); 
			$objPHPExcel->getActiveSheet()->setCellValue($SIGNENG.$SIGNNUM, iconv("big5","utf-8",getusername($SIGN2)));
			$objPHPExcel->getActiveSheet()->getStyle($SIGNENG.$SIGNNUM)->applyFromArray($styleThinBlackBorderOutline); 
			$SIGNENG++;
			$objPHPExcel->getActiveSheet()->setCellValue($SIGNENG.'4', iconv("big5","utf-8","主管備註"));
			$objPHPExcel->getActiveSheet()->getStyle($SIGNENG.'4')->applyFromArray($styleThinBlackBorderOutline); 
			$objPHPExcel->getActiveSheet()->setCellValue($SIGNENG.$SIGNNUM, iconv("big5","utf-8",$Remark2));
			$objPHPExcel->getActiveSheet()->getStyle($SIGNENG.$SIGNNUM)->applyFromArray($styleThinBlackBorderOutline); 
			
			
			
			
			
			
			$objPHPExcel->getActiveSheet()->setCellValue($eng.$num, iconv("big5","utf-8","'".trim($row2[0])));
			$objPHPExcel->getActiveSheet()->getStyle($eng.$num)->applyFromArray($styleThinBlackBorderOutline);  ///畫儲存格外框
			$objPHPExcel->getActiveSheet()->getStyle($eng.$num)->getAlignment()->setWrapText(true);//自動換行
			if($timetitle1<>'')
			{
				$objPHPExcel->getActiveSheet()->setCellValue($eng1.$num1, iconv("big5","utf-8","'".trim($row2[0])));
				$objPHPExcel->getActiveSheet()->getStyle($eng1.$num1)->applyFromArray($styleThinBlackBorderOutline);  ///畫儲存格外框
				$objPHPExcel->getActiveSheet()->getStyle($eng1.$num1)->getAlignment()->setWrapText(true);//自動換行
				//$objPHPExcel->getActiveSheet()->insertNewRowBefore(($num1+1),1);
			}
			$objPHPExcel->getActiveSheet()->insertNewRowBefore(($num+1),1);
			if($sn1<>''){$num1++;}
			$num++;$num1++;$B++;
		}
		$A++;$B++;$Num1++;
	}
}
	//echo '</table>';
	$objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel,"Excel2007");
	$A=explode("(",formname($_SESSION['form']));
	$_SESSION['filename']=$A[0].'('.des($_SESSION['datepicker7']).').xlsx';
	$objWriter->save('../PRODUCE/Download/'.$A[0].'_'.des($_SESSION['datepicker7']).'.xlsx');
	
	$A=explode("(",formname($_SESSION['form']));
	$path_root=$_SERVER['HTTP_HOST'];
	if($_SESSION['pid']=='')
	{
		echo '<script>document.location.href="http://'.$path_root.'/PRODUCE/Download/'.$A[0].'_'.des($_SESSION['datepicker7']).'.xlsx";</script>';
		if($_SESSION['way']=='A'){$form='form1';}else{$form='form';}
		$query="SELECT distinct UD.TAG_NO from UTT_CHECK_DATA UD left join UTT_TAGNO_DATA UN ON UD.TAG_NO=UN.TAG_NO where ".$form."=".$_SESSION['form']."";
		$result=mssql_query($query);
		while($row=mssql_fetch_array($result))
		{
			unset($_SESSION[trim($row[0])]);
		}
	}
	else
	{
		echo '<script>document.location.href="http://'.$path_root.'/PRODUCE/Download/'.$_SESSION['pid'].'_'.des($_SESSION['datepicker7']).'.xlsx";</script>';
	}
	unset($_SESSION['time1'],$_SESSION['time2']);
}
function remark()
{
	echo '<script>
	var name=prompt("備註(如無須填入直接按確定)",""); 
	if(name==""){location.href="index.php?url=UTT_check&remark=empty";}else{location.href="index.php?url=UTT_check&remark=" + name;}
	</script>';
}
function dateform1($d1)  //2017/01/01 => 20170101
{	
	$rt=str_replace("/","",$d1);
	return $rt;
}
function formname($d1)  //2017/01/01 => 20170101
{	
	$query="select * from UTT_FORM_DATA where [index]='".$d1."'";
	$result=mssql_query($query);
	$row=mssql_fetch_array($result);
	$rt=trim($row['Form']);
	return $rt;
}
function hr_duteies($val)
{
	require_once("../connections/conn_hr.php");
	$query2="select duties from EMPLOYEE_DATA where empno='".$val."'";
	$result2=mssql_query($query2);
	$row2=mssql_fetch_array($result2);
	$sign1=array();
	if(trim($row2[0])>=7 and trim($row2[0])<17 or substr($_SESSION['uid'],1)=='589'){$_SESSION['director']=2;$sign1[0]='<input type="submit" name="sign1" value="批次簽核" style="background-color:green;">';}
	if(substr($_SESSION['uid'],1)=='319' or substr($_SESSION['uid'],1)=='029' or substr($_SESSION['uid'],1)=='066' or substr($_SESSION['uid'],1)=='1048' or substr($_SESSION['uid'],1)=='1303' or substr($_SESSION['uid'],1)=='1263' or substr($_SESSION['uid'],1)=='1103' or substr($_SESSION['uid'],1)=='1044' or substr($_SESSION['uid'],1)=='1041' or substr($_SESSION['uid'],1)=='1100' or substr($_SESSION['uid'],1)=='1065'){$_SESSION['director']=1;$sign1[1]='<input type="submit" name="sign2" value="批次簽核" style="background-color:green;">';
	$sign1[0]='<input type="submit" name="sign1" value="批次簽核" style="background-color:green;">';
	}
	// include("../connections/conn.php");
	return $sign1;
	
}
