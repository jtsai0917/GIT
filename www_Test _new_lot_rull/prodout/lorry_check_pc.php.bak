if(isset($_POST['submit']))
{
	
	if($num==0)
	{
		$query="insert into OUT_CHECK_LORRY (OTD_NO,OCL_LY_NO,OCL_LOT_NO,OCL_BACK_DATE,OCL_CHK_DATE,OCL_CHK_BAR
			,OCL_CHK_SPEC_LINK,OCL_CHK_PIPE,OCL_CHK_LOT_PASTED,OCL_CF_MAN,OCL_CHK_SURFACE,OCL_CHK_UPCAP,OCL_CHK_HOSE) 
			VALUES ('".$_GET['otdno']."','".$_POST['lorryno']."','".$_GET['lid']."',NULL,'".dod($_POST['datepicker1'])."','".$_POST['RadioGroup1']."'
			,'".$_POST['RadioGroup3']."','".$_POST['RadioGroup4']."','".$_POST['RadioGroup2']."','".strtoupper($_SESSION['uid'])."',
			'".$_POST['RadioGroup5']."','".$_POST['RadioGroup6']."','".$_POST['RadioGroup7']."')";	
		$result1=mssql_query($query);
		if($result1)
		{
			my_msg("已經完成出荷檢查","index.php?url=lorry_check_list");
		}
		else
		{
			my_msg("發生不可預期的錯誤，請通知IT 進行檢查","index.php?url=lorry_check_list");	
		}
	}
	else
	{
		$query="update OUT_CHECK_LORRY set OTD_NO='".$_GET['otdno']."',OCL_LY_NO='".$_POST['lorryno']."',OCL_BACK_DATE=NULL,OCL_CHK_DATE='".dod($_POST['datepicker1'])."',OCL_CHK_BAR='".$_POST['RadioGroup1']."',OCL_CHK_SPEC_LINK='".$_POST['RadioGroup3']."',OCL_CHK_PIPE='".$_POST['RadioGroup4']."',OCL_CHK_LOT_PASTED='".$_POST['RadioGroup2']."',OCL_CF_MAN='".strtoupper($_SESSION['uid'])."',OCL_CHK_SURFACE='".$_POST['RadioGroup5']."',OCL_CHK_UPCAP='".$_POST['RadioGroup6']."',OCL_CHK_HOSE='".$_POST['RadioGroup7']."' where OCL_LOT_NO='".$_GET['lid']."'";	
		$result2=mssql_query($query);
		if($result2)
		{
			my_msg("已經完成出荷檢查","index.php?url=lorry_check_list");
		}
		else
		{
			my_msg("發生不可預期的錯誤，請通知IT 進行檢查","index.php?url=lorry_check_list");	
		}
	}
