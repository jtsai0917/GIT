function check_status($lotno,$disable1){
	$query1="SELECT Signatory_Name, sign_items, Signatory_ID, LotNo, sign_datetime FROM Instruction_Signatory where LotNo='".$lotno."' and cancel=0 order by sign_datetime desc";
//	echo $query1."<BR>";
	$result1=mssql_query($query1);
	if($row1=mssql_fetch_row($result1)){
		$o= $row1[0];
	}
	else{
		$o= '簽核';
	}
	$url='./index.php?url=signatory_fill&lotno='.$lotno;
	if($disable1==1){
		echo '<a target="_blank" href="'.$url.'">'.$o.'</a>';
	}
	else{
		echo $o;
	}
}
