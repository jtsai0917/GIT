                          CTP_BIGHOSEBAR, CTP_BIGHOSEBAR_Length, CTP_ExportCountLimit, 
                          CTP_SAMPLE_MODE, CTP_CUST_PROD_NO1, CTP_CUST_PROD_NO2)
