function get_disc($itm,$efm,$pid)
{
	$query="select disc FROM ani_excel_location WHERE (pid = '".$pid."') AND (item = '".$itm."') AND (efm = '".$efm."')";
	
	$result=mssql_query($query);
	$row=mssql_fetch_row($result);
	if(trim($row[0])=='NULL'){	return $itm ;}
	else {return $row[0];}
}

