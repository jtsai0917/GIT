	}
	
function prod($pono){
	$query="SELECT distinct PDD_PROD_NO FROM OUT_PRODUCT WHERE (OPM_ORDER_NO = '".$pono."')";
	$result=mssql_query($query);
	while($row=mssql_fetch_array($result)){
		$rtn=$rtn.$row['PDD_PROD_NO']."<br>";	
	}
	return $rtn;
}
