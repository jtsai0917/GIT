function update_printed($id)
{
	$query="UPDATE YG_CHECK_DETAIL SET PRINTED = 1,print_time ='".date("YmdHis")."' WHERE (car_out_id = ".$id.") ";	
	$result=mssql_query($query);
	$query="UPDATE YG_CAR_OUT SET PRINTED = N'".date("YmdHis")."' WHERE ([index] = ".$id.")";	
	$result=mssql_query($query);
}
