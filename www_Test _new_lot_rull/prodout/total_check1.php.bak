		$row=mssql_fetch_array($result);
		$numRows=mssql_num_rows($result);
		$QTY=trim($row[0]);
		if($aa[$i][2]=='L')
		{
			$query="select PDD_LITER_KG from PRODUCT_DATA where PDD_PROD_NO='".trim($row[1])."'";
			$result=mssql_query($query);
			$row=mssql_fetch_array($result);
			$QTY=$QTY/trim($row[0]);
		}
		//echo round($QTY).','.$aa[$i][1].'<br>';
		if($aa[$i][1]!='' and $aa[$i][1]!=0 and round($QTY)!=$aa[$i][1] and $i>1){
		$query="update LORRY_EXAMINE_LIST set LEL_CUST_QTY='".$aa[$i][1]."' where LEL_LOT_NO='".$aa[$i][0]."'";
		//echo $query.'<br>';
		$result=mssql_query($query);
		}
	}
	refresh();
