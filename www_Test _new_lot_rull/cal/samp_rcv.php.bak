function get_gid($smpid){
	$query="select gid from Sample_Location where SMPID = '".$smpid."' order by gid desc ";
//	echo $query."<BR>";
	$result=mssql_query($query);
	if($result){
		$row=mssql_fetch_row($result);
		if($row[0]<>''){
			return $row[0];
		}
		else{
			return max_gid();
		}
	}
	else{
		return max_gid();
	}
}	
function max_gid(){
	$query="select max(gid) + 1 as mx from Sample_Location";
	$result=mssql_query($query);
	if($result){
		$row=mssql_fetch_row($result);
	return $row[0];
	}
	else{
		return 1;
	}
}

