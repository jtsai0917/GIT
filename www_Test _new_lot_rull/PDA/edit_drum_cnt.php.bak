<?php
	session_start();
	include("../lib/fun.php");
	auth('11-01',$_SESSION['aut']);
	$lid=trim($_GET['lid']);
	echo "Lot No : ".$lid."<BR>";;
	echo '<form id="form1" name="form1" method="post" action=""><table width="300" border="1"><tr><td align="center">SN</td><td align="center">桶號</td><td align="center">製造批號</td></tr>';
	include "../connections/conn.php";
	$query="SELECT EWD_SERIAL_NO, EWD_DRUM, EWD_MAKELOT FROM EL_WASH_DRUM WHERE (FDM_LOT_NO = '".$lid."') order by EWD_SERIAL_NO";
	$result=mssql_query($query);

	while($row=mssql_fetch_array($result)){
		echo '<tr><td align="center">'.$row['EWD_SERIAL_NO'].'</td><td align="center"><input type="checkbox" name="chkbox[]" value="'.$row['EWD_SERIAL_NO'].'"> &nbsp; <input type="text" size="8" name="drumno[]" value="'.$row['EWD_DRUM'].'"></td><td align="center">'.$row['EWD_MAKELOT'].'</td></tr>';

	}
	echo '<input type="submit" name="submit" value="enter"></form><a href="index.php">返回主頁</a>';
	if(isset($_POST['submit'])){	
		$lid=trim($_GET['lid']);
		include "../connections/conn.php"	;
		$aa=$_POST['chkbox'];
		$bb=$_POST['drumno'];
		echo "共選擇 ".count($aa). " 筆<BR>";
		for($i=0;$i < count($aa);$i++){
			$s=$aa[$i]-1;
			$query="update EL_WASH_DRUM set EWD_DRUM='".trim($bb[$s])."' where  (FDM_LOT_NO = '".$lid."') and  EWD_SERIAL_NO= ".$aa[$i] ;
			$result=mssql_query($query);
			echo "序號".$aa[$i]."之桶號已更新為: ".$bb[$s]."<BR>";
		//	echo $query."<BR>";
		}
	}
?>