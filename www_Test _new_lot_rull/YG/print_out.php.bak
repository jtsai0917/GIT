                            PRODUCT_DATA.PDD_PROD_NAME, FILLPLAN_OUT_DECIDE.LY_SN, OUT_DECISION.OPM_ETA_DATE, YG_CHECK_DETAIL.drum_cnt as dcount 
FROM              PRODUCT_DATA INNER JOIN
                            FILLPLAN_OUT_DECIDE ON 
                            PRODUCT_DATA.PDD_PROD_NO = FILLPLAN_OUT_DECIDE.PDD_PROD_NO FULL OUTER JOIN
                            EMPLOYEE_DATA RIGHT OUTER JOIN
                            OUT_PRODUCT INNER JOIN
                            YG_CHECK_DETAIL ON OUT_PRODUCT.OPD_QTY_DRUM = YG_CHECK_DETAIL.drum_cnt AND 
                            OUT_PRODUCT.OPD_LOT_NO = YG_CHECK_DETAIL.LOT_NO LEFT OUTER JOIN
                            YG_CAR_OUT ON YG_CHECK_DETAIL.car_out_id = YG_CAR_OUT.[index] ON 
                            EMPLOYEE_DATA.EMP_NO = YG_CHECK_DETAIL.CHECKER LEFT OUTER JOIN
                            CUSTOMER_DATA INNER JOIN
                            OUT_DECISION ON CUSTOMER_DATA.CTD_CUST_NO = OUT_DECISION.CTD_CUST_NO ON 
                            OUT_PRODUCT.OPM_ORDER_NO = OUT_DECISION.OPM_ORDER_NO ON 
                            FILLPLAN_OUT_DECIDE.FDM_LOT_NO = YG_CHECK_DETAIL.LOT_NO   
WHERE          (YG_CHECK_DETAIL.car_out_id = ".$id.")"; 
