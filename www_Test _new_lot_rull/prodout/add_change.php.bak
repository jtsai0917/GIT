$query="SELECT FILLPLAN_OUT_DECIDE.CTD_CUST_NO AS Expr1, CUSTOMER_DATA.CTD_CUST_SHORT_NAME, 
                            FILLPLAN_OUT_DECIDE.FDM_QTY, FILLPLAN_OUT_DECIDE.FDM_QTY_UNIT, 
