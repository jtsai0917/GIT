<?php
function sup($sup){
if(trim($sup)=="Y"){ return 'checked="checked"';}
}
function fifo($fifo){
if(trim($fifo)=="Y"){ return 'checked="checked"';}
}
function vsup($vsup){
if(trim($vsup)=="on"){ return 'Y';}
else{ return 'N';}
}
function vfifo($vfifo){
if(trim($vfifo)=="on"){ return 'Y';}
}
