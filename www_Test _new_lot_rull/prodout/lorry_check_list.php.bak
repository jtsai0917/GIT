                   PRODUCT_DATA ON OUT_PRODUCT.PDD_PROD_NO = PRODUCT_DATA.PDD_PROD_NO LEFT OUTER JOIN
                   OUT_CHECK_LORRY ON OUT_PRODUCT.OTD_NO = OUT_CHECK_LORRY.OTD_NO 
