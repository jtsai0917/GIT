	$query="SELECT DISTINCT 
                            PRODUCT_DATA.PDD_CHEMICAL AS CHEMICAL, EMPLOYEE_DATA.EMP_NAME, 
                            CUSTOMER_DATA.CTD_CUST_SHORT_NAME AS CSN, YG_CHECK_DETAIL.PLACE, 
