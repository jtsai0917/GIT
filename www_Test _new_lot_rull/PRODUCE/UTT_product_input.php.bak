if(isset($_POST['del']))
{
	$query="DELETE UTT_TAGNO_DATA WHERE [index]='".$_POST['idx']."'";
	$result=mssql_query($query);
	if($result){
		my_msg('刪除完畢');
	}
}
if(isset($_POST['save'])){
	$low=trim($_POST['low']);
	$high=trim($_POST['high']);
	if(trim($_POST['low'])!='' or trim($_POST['high'])!='')
	{
		if($_POST['mode']=='GT')
		{
			$spec='>';
		}
		elseif($_POST['mode']=='LS')
		{
			$spec='<';
			$low=trim($_POST['high']);
			$high=trim($_POST['low']);
		}
		elseif($_POST['mode']=='BT'){$spec='~';}
		elseif($_POST['mode']=='SAME'){$spec='=';$low='';$high=strtoupper(trim($_POST['high']));}
		$SPEC1=$_POST['low'].$spec.$_POST['high'];
		if($_POST['mode']=='SAME' and trim($_POST['high'])==''){my_msg('請填入"大"欄位');}
	}
	$query="update UTT_TAGNO_DATA set TAG_NO='".$_POST['TAG_NO']."', project='".$_POST['project']."',unit='".$_POST['unit']."',spec='".$SPEC1."',low='".$low."',high='".$high."',mode='".$_POST['mode']."',form='".$_POST['form']."',form1='".$_POST['form1']."' where TAG_NO='".$_SESSION['TAG_NO']."'";
	$result=mssql_query($query);
	unset($_SESSION['TAG_NO']);
	echo '<font size="+1">儲存完成!</font>';
	}
if(isset($_POST['add']))
{
