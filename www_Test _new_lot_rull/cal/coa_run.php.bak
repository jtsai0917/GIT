<?php

session_start();
include("../connections/conn.php");
include("../lib/fun.php");
include("../lib/jtsai.php");
	require_once ('../PHPWord/PHPWord.php');
	$PHPWord = new PHPWord();
	if(isset($_POST['print'])){$str='./all/TYS.docx';echo "TYS";}
	if(isset($_POST['print_mctw'])){$str='./all/MCTW_COA.docx';
	echo "MCTW<BR>";}

	$document = $PHPWord->loadTemplate($str);
	$num=0;
	$i=0;
	$aa=$_POST['chk'];
	//	print_r($aa);
	//$item=explode(";", $aa);
		//print_r($item);
	//echo $item;
//	if(trim($_SESSION['cust_no'])=='')
//	{echo "請選擇客戶!";}
//	if($_SESSION['cust_no']<>'')
	//echo $_SESSION['NB'];
		for($T=0;$T<count($aa);$T++)
		{	
			{	
				//echo $T;
				//echo $_POST['chk4'].'<br>';
				//$_SESSION['chkkk']=$_POST['chk'.$i.''];
				$chose[$i]=explode(",",$aa[$i]);		
	//			print_r($chose[$i]);
				
				$document->setValue("CUST",get_cust_name($chose[$i][3]));
//				echo get_cust_name($chose[$i][3]);
				$tip= substr(get_cust_name($chose[$i][3]),0,4);
				if($tip=='台積'){
					$ti=1;
				}
				else{
					$ti=0;
				}
			//	echo $chose[0][3];
				$date3[$i]=dat1($chose[$i][2]);
			//	echo $date3[0];
				$document->setValue("DAT",$date3[$i]);
				$prints="select distinct OAF_PACKAGE_DESC as pack,OP.OPD_QTY_DRUM,PD.PDD_STYLE,PD.PDD_CLASS,PD.PDD_PROD_NAME,PD.PDD_TYPE,OP.OPD_LOT_NO,OP.OAF_PACKAGE
		,OP.OPD_QTY_KG,OP.OPD_ACC_UNIT
		from OUT_PRODUCT as OP 
		inner join PRODUCT_DATA as PD on OP.PDD_PROD_NO=PD.PDD_PROD_NO
		inner join OUT_DECISION as OD on OD.OTD_NO=OP.OTD_NO 
		left join OUT_PLAN_FROM_FILE as OPF on OP.OAF_ACC_ID=OPF.OAF_ACC_ID 
		where OP.OPM_ORDER_NO='".$chose[$i][0]."'   and  OD.OPM_ETA_DATE='".$chose[$i][2]."' and  CTD_CUST_NO='".$chose[$i][3]."' and  OPD_SERIAL_NO='".$chose[$i][5]."' and 
		OPD_LOT_NO='".$chose[$i][1]."'";
//		echo $prints."<BR><BR>";
		$result = mssql_query($prints);
	
	while($row = mssql_fetch_array($result))
	{	
		if(trim($row['PDD_TYPE'])!="LY")
		{
//			echo "SSSS".$LOTNO=trim($row['OPD_LOT_NO']);
			$document->setValue("NAME".$num,$row['PDD_PROD_NAME']);
			$document->setValue("STYLE".$num,$row['PDD_STYLE']);
			//$document->setValue("STYLE".$num,$row['pack']);
			//$document->setValue("QTY".$num,$row['PDD_STYLE']."*".$row['OPD_QTY_DRUM']);
			if(trim($row['PDD_STYLE'])=='BTL'){
				$document->setValue("QTY".$num,$row['OAF_PACKAGE']."/".$row['PDD_STYLE']."*".$row['OPD_QTY_DRUM']);
			}
			else{
			$document->setValue("QTY".$num,$row['OAF_PACKAGE']."*".$row['OPD_QTY_DRUM']);
			}
			if($row['PDD_CLASS']=='商品'){
				$LOTNO=trim($row['OPD_LOT_NO']);
			}
			else{
				$LOTNO=substr(trim($row['OPD_LOT_NO']),0,7);
			}
			
			$document->setValue("LOT".$num,$LOTNO);
			$num++;
		}
		elseif(trim($row['PDD_TYPE'])=="LY")
		{
			$document->setValue("NAME".$num,$row['PDD_PROD_NAME']);
			$document->setValue("STYLE".$num,$row['OAF_PACKAGE']);
			$document->setValue("QTY".$num,floor($row['OPD_QTY_KG'])." ".$row['OPD_ACC_UNIT']);
//			$document->setValue("QTY".$num,$row['pack']."*".$row['OPD_QTY_DRUM']);
			if($ti==1){
				$LOTNO=substr(trim($row['OPD_LOT_NO']),0,7).substr(trim($row['OPD_LOT_NO']),-3,3);
			}
			else{
				$LOTNO=$row['OPD_LOT_NO'];
			}
				

	
		$document->setValue("LOT".$num,$LOTNO);
		$num++;
		}
		else
		{
			$document->setValue("NAME".$num,$row['PDD_PROD_NAME']);
			$document->setValue("STYLE".$num,$row['OAF_PACKAGE']);
			$document->setValue("QTY".$num,$row['pack']."*".$row['OPD_QTY_DRUM']);
			

				$LOTNO=$row['OPD_LOT_NO'];
			
		}
	}
	
	
			}//if
			$i++;
		}///for
		
	for($i=0;$i<15;$i++)
	{
		$document->setValue("NAME".$num," ");
		$document->setValue("STYLE".$num," ");
		$document->setValue("QTY".$num," ");
		$document->setValue("LOT".$num," ");
		
		$num++;
	}
	$document->save('./all/TYS1.docx');

	
	
			
			
$path_root=$_SERVER['HTTP_HOST'];
			echo '</br>';
			echo "請先儲存後列印";
		echo '<script>document.location.href="http://'.$path_root.'/cal/all/TYS1.docx";</script>';	
	

function dat1($ds){   //day-style  201509020102=>09/02/2015
		$dat=substr($ds,0,+4)."/".substr($ds,4,+2)."/".substr($ds,6,+2);
	return $dat;
}

?>