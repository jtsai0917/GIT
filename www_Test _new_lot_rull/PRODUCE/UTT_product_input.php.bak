if(isset($_POST['new']))
{
	$query="select * from UTT_TAGNO_DATA WHERE TAG_NO='".trim($_POST['TAG_NO'])."'";
	$result=mssql_query($query);
	$Num=mssql_num_rows($result);
	if($Num<>0){my_msg('已有資料!');}
	if($_POST['mode']!='REMARK')
	{
		if($_POST['mode']=='GT' and $_POST['low']>=$_POST['high'])
		{
			my_msg('spec錯誤');
		}
		elseif($_POST['mode']=='LS' and $_POST['low']<>'')
		{
			my_msg('spec錯誤');
		}
		elseif($_POST['mode']=='BT' and $_POST['low']=='' and $_POST['high']=='' or $_POST['low']>=$_POST['high'])
		{
			my_msg('spec錯誤');
		}
		elseif($_POST['mode']=='SAME' and $_POST['high']=='')
		{
			my_msg('請填入"大"欄位');
		}
	}
	if($_POST['mode']=='GT')
	{
		$high=$_POST['high'];
		$low=$_POST['low'];
	}
	if($_POST['mode']=='LS')
	{
		$high=$_POST['low'];
		$low=$_POST['high'];
	}
	if($_POST['mode']=='BT')
	{
		
		$high=$_POST['high'];
		$low=$_POST['low'];
	}
	if($_POST['mode']=='SAME')
	{
		$high=strtoupper($_POST['high']);
		$low=$_POST['low'];
	}
	if($_POST['mode']=='REMARK')
	{
		$high=$_POST['high'];
		$low=$_POST['low'];
	}
	if($_POST['mode']=='GT'){$spec='>'.$_POST['high'];}
	if($_POST['mode']=='LS'){$spec='<'.$_POST['high'];}
	if($_POST['mode']=='SAME'){$spec='='.$_POST['high'];}
	if($_POST['mode']=='BT'){$spec=$_POST['low'].'~'.$_POST['high'];}
	if($_POST['mode']=='REMARK'){$spec='紀錄';}
	$query="insert into UTT_TAGNO_DATA (TAG_NO, project, unit, spec, high, low, mode, form, form1, savetime, saveuid) values ('".$_POST['TAG_NO']."','".$_POST['project']."','".$_POST['unit']."','".$spec."','".$high."','".$low."','".$_POST['mode']."','".$_POST['form']."','".$_POST['form1']."','".date(Ymdhis)."','".$_SESSION['uid']."')";
	$result=mssql_query($query);
	my_msg('新增完畢!');
}
function dateform1($d1)  //2017/01/01 => 20170101
{	
	$rt=str_replace("/","",$d1);
	return $rt;
}
function tag_cname($d2)
{
	$query="select project from UTT_TAG_DATA where TAG_NO='".$d2."'";
	$result=mssql_query($query);
	$row=mssql_fetch_array($result);
	$d3=trim($row[0]);
	return $d3;
}
function UTT_FORM(){///橫
	echo '<select name="form">';
	$query1="select * from UTT_FORM_DATA where [index]='".$_SESSION['form']."' and way='B' order by Form";
	$result1=mssql_query($query1);
	$row1=mssql_fetch_array($result1);
	echo '<option value="'.$row1['index'].'">'.trim($row1['Form']).'</option>';
	$query2="select * from UTT_FORM_DATA where way='B'";
	$result2=mssql_query($query2);
	while($row2=mssql_fetch_array($result2)){
	if(trim($row1['index'])!=trim($row2['index']) or $row1['index']==''){
	echo '<option value="'.trim($row2['index']).'">'.trim($row2['Form']).'</option>';}
	}
	echo'</select>';
	}
function UTT_FORM1(){///直
	echo '<select name="form1">';
	$query1="select * from UTT_FORM_DATA where [index]='".$_SESSION['form1']."' and way='A' order by Form";
	$result1=mssql_query($query1);
	$row1=mssql_fetch_array($result1);
	$index=explode(trim($row1['Form']));
	echo '<option value="'.$row1['index'].'">'.trim($row1['Form']).'</option>';
	$query2="select * from UTT_FORM_DATA WHERE way='A'";
	$result2=mssql_query($query2);
	while($row2=mssql_fetch_array($result2)){
	if(trim($row1['index'])!=trim($row2['index']) or $row1['index']==''){
	echo '<option value="'.trim($row2['index']).'">'.trim($row2['Form']).'</option>';}
	}
	echo'</select>';
	}
function newprod(){///新增料號表單(橫)
echo '<select name="form">';
	$query2="select * from UTT_FORM_DATA WHERE way='B' order by Form";
	$result2=mssql_query($query2);
	while($row2=mssql_fetch_array($result2)){
	echo '<option value="'.trim($row2['index']).'">'.trim($row2['Form']).'</option>';}
	echo'</select>';
}
function newprod1(){///新增料號表單(直)
echo '<select name="form1">';
