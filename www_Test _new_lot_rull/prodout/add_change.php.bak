		  &nbsp;&nbsp;</td></tr>';
	echo '<tr><td width="512" align="right"><input name="leave" type="submit" size="28" value="         離   開        " /></td><td><input name="save" type="submit" id="save" size="28" value="         儲    存        " /></td></tr>';
	echo '</table></form>';

if(isset($_POST['save']))
